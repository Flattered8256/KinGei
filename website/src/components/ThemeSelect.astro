---
import { Icon } from '@astrojs/starlight/components';

const prefix = Astro.locals.t('themeSelect.accessibleLabel');
const labels = {
	light: Astro.locals.t('themeSelect.light'),
	dark: Astro.locals.t('themeSelect.dark'),
};
---

<starlight-theme-select data-pref="dark">
	<button
		type="button"
		aria-label={`${prefix}: ${labels.dark}`}
		data-label-prefix={prefix}
		data-label-light={labels.light}
		data-label-dark={labels.dark}
	>
		<Icon name="sun" class="icon-light" />
		<Icon name="moon" class="icon-dark" />
	</button>
</starlight-theme-select>

<script is:inline>
	(() => {
		const stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
		const pref =
			stored === 'light' || stored === 'dark'
				? stored
				: matchMedia('(prefers-color-scheme: light)').matches
					? 'light'
					: 'dark';
		document.querySelectorAll('starlight-theme-select').forEach((el) => {
			el.dataset.pref = pref;
			const button = el.querySelector('button');
			if (!(button instanceof HTMLButtonElement)) return;
			const prefix = button.dataset.labelPrefix ?? '';
			const label = pref === 'light' ? button.dataset.labelLight : button.dataset.labelDark;
			button.setAttribute('aria-label', `${prefix}: ${label ?? pref}`);
		});
	})();
</script>

<style>
	@layer starlight.components {
		starlight-theme-select[data-pref='light'] :global(.icon-dark),
		starlight-theme-select[data-pref='dark'] :global(.icon-light) {
			display: none;
		}

		button {
			display: flex;
			align-items: center;
			justify-content: center;
			margin-block: -0.5em;
			padding: 0.5em;
			border: 0;
			background: transparent;
			color: var(--sl-color-gray-2);
			cursor: pointer;
		}

		button:hover {
			color: var(--sl-color-white);
		}
	}
</style>

<script>
	type Theme = 'dark' | 'light';

	const storageKey = 'starlight-theme';

	const parseTheme = (theme: unknown): Theme | 'auto' =>
		theme === 'dark' || theme === 'light' ? theme : 'auto';

	const loadTheme = (): Theme | 'auto' =>
		parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

	function storeTheme(theme: Theme): void {
		if (typeof localStorage !== 'undefined') {
			localStorage.setItem(storageKey, theme);
		}
	}

	const systemTheme = (): Theme =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	const resolvedTheme = (): Theme => {
		const stored = loadTheme();
		return stored === 'auto' ? systemTheme() : stored;
	};

	function labelFor(button: HTMLButtonElement, theme: Theme): string {
		return (theme === 'light' ? button.dataset.labelLight : button.dataset.labelDark) ?? theme;
	}

	function applyTheme(theme: Theme): void {
		document.querySelectorAll('starlight-theme-select').forEach((el) => {
			el.dataset.pref = theme;
			const button = el.querySelector('button');
			if (!(button instanceof HTMLButtonElement)) return;
			const prefix = button.dataset.labelPrefix ?? '';
			button.setAttribute('aria-label', `${prefix}: ${labelFor(button, theme)}`);
		});
		document.documentElement.dataset.theme = theme;
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') applyTheme(systemTheme());
	});

	class StarlightThemeSelect extends HTMLElement {
		constructor() {
			super();
			applyTheme(resolvedTheme());
			this.querySelector('button')?.addEventListener('click', () => {
				const next: Theme = resolvedTheme() === 'dark' ? 'light' : 'dark';
				storeTheme(next);
				applyTheme(next);
			});
		}
	}

	if (!customElements.get('starlight-theme-select')) {
		customElements.define('starlight-theme-select', StarlightThemeSelect);
	}
</script>
